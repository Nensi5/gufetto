# Kopiraj u .env i popuni:  cp .env.example .env

# SQL Server traži jaku lozinku: min. 8 karaktera, velika i mala slova, broj i simbol.
# Izbegavaj $ @ : / ? # u lozinci ($ Compose tumači kao promenljivu, ostalo kvari connection string).
MSSQL_SA_PASSWORD=Promeni-Me-2026!

# Port na kom je Gufetto dostupan (http://localhost:PORT); promeni ako je 8080 zauzet
GUFETTO_PORT=8080

# Docker Hub nalog i verzija image-a (za docker compose build / push / pull)
DOCKERHUB_USER=
GUFETTO_TAG=latest

# Besplatni ključevi:
#   AbuseIPDB:  https://www.abuseipdb.com/account/api
#   VirusTotal: https://www.virustotal.com/gui/my-apikey
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# Koliko sati važi keširan rezultat
IOC_CACHE_TTL_HOURS=24

# Za lokalni rad bez Docker-a (docker-compose ovo pregazi SQL Server-om)
DATABASE_URL=sqlite:///./gufetto.db
